def get_recent_chat(chat_id: int, limit: int = 6) -> str:
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT role, content FROM user_chat_history WHERE chat_id = ? ORDER BY id DESC LIMIT ?",
                  (chat_id, limit))
        rows = list(reversed(c.fetchall()))
        conn.close()
    if not rows:
        return "No previous messages."
    formatted = []
    for idx, (role, content) in enumerate(rows):
        cap = 1200 if idx == len(rows) - 1 else 500
        trimmed = content if len(content) <= cap else content[:cap] + "... [truncated]"
        formatted.append(f"{role}: {trimmed}")
    return "\n".join(formatted)

def get_recent_chat_messages(chat_id: int, limit: int = 6) -> list:
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT role, content FROM user_chat_history WHERE chat_id = ? ORDER BY id DESC LIMIT ?",
                  (chat_id, limit))
        rows = list(reversed(c.fetchall()))
        conn.close()
    msgs = []
    for idx, (role, content) in enumerate(rows):
        cap = 1200 if idx == len(rows) - 1 else 500
        trimmed = content if len(content) <= cap else content[:cap] + "..."
        if role == "User":
            msgs.append(HumanMessage(content=trimmed))
        else:
            msgs.append(AIMessage(content=trimmed))
    return msgs

