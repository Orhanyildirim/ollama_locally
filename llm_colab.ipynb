# ==========================================
# PORTFOLIO PIPELINE & SCHEDULER
# ==========================================
def run_market_pipeline(force_report: bool = False, target_chat_id: int = None):
    now = datetime.now(ZoneInfo("Europe/Zurich"))
    if not force_report and not (8 <= now.hour < 23):
        return
    tickers = get_watchlist()
    if not tickers:
        if target_chat_id:
            send_safe(target_chat_id, "ℹ️ Watchlist is empty. Add tickers with /add.")
        return

    try:
        result = market_app.invoke({
            "tickers": tickers,
            "force_report": force_report,
            "raw_data": "",
            "has_new_info": False,
            "has_price_shock": False,
            "shock_notes": [],
            "final_report": "",
        })
        should_notify = force_report or result["has_new_info"] or result["has_price_shock"]
        if should_notify and result.get("final_report"):
            header = "📊 **Portfolio Briefing**"
            if result["shock_notes"]:
                header += "\n" + " | ".join(result["shock_notes"])
            report_text = f"{header}\n\n{result['final_report']}"

            if target_chat_id:
                send_safe(target_chat_id, report_text)
            else:
                for uid in ALERT_CHAT_IDS:
                    send_safe(uid, report_text)
    except Exception as e:
        traceback.print_exc()
        send_safe(ADMIN_CHAT_ID, f"⚠️ Scan error: {str(e)}")

def scheduler_loop():
    schedule.every(2).hours.do(run_market_pipeline)
    while True:
        schedule.run_pending()
        time.sleep(30)

