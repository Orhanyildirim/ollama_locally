def analyze_image_with_qwen_vl(img_b64: str, prompt_text: str, chat_history: str = "", user_label: str = "User", target_lang: str = "") -> str:
    vision_msg = HumanMessage(
        content=[
            {
                "type": "text",
                "text": (
                    f"Recent conversation:\n{chat_history}\n\n"
                    f"User's current message about this image: '{prompt_text}'\n\n"
                    "Look closely at the image and answer directly with concrete visual details. "
                    "If asked to guess ages, commit to specific single-number estimates (e.g. 'around 29' and 'around 36'), "
                    "NOT huge vague ranges like '20s or 30s'."
                ),
            },
            {"type": "image_url", "image_url": f"data:image/jpeg;base64,{img_b64}"},
        ]
    )
    lang_rule = (
        f"Write 100% of your reply in {target_lang}."
        if target_lang
        else "Write 100% of your reply in the EXACT SAME LANGUAGE as USER'S MESSAGE (any language—Greek, Turkish, German, English, etc.)."
    )
    with llm_lock:
        visual_answer = clean_llm_output(vision_llm.invoke([vision_msg]).content)

        chat_prompt = (
            f"You are talking to: {user_label}.\n"
            f"USER'S MESSAGE: '{prompt_text}'\n"
            f"VISUAL ANALYSIS: {visual_answer}\n\n"
            "STRICT RULES:\n"
            f"1. {lang_rule} Never produce awkward literal translations or mix languages.\n"
            "2. Answer directly using the specific numbers/details from VISUAL ANALYSIS. No robotic disclaimers.\n"
            "3. Sound like a sharp, natural friend. Max 2-3 short sentences."
        )
        return clean_llm_output(chat_llm.invoke(chat_prompt).content)

