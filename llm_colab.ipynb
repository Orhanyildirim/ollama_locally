# ==========================================
# SAFE HTML CHUNKING (PRESERVES CODE BLOCKS & # COMMENTS)
# ==========================================
def format_for_telegram(text: str) -> str:
    text = clean_llm_output(text)

    code_blocks = []
    def save_code_block(match):
        code = html.escape(match.group(1).strip("\n"))
        code_blocks.append(f"<pre><code>{code}</code></pre>")
        return f"@@CODEBLOCK{len(code_blocks) - 1}@@"

    text = re.sub(r"```(?:[a-zA-Z0-9_+-]+[ \t]*\n|\n)?(.*?)```", save_code_block, text, flags=re.DOTALL)

    inline_codes = []
    def save_inline_code(match):
        inline_codes.append(f"<code>{html.escape(match.group(1))}</code>")
        return f"@@INLINECODE{len(inline_codes) - 1}@@"

    text = re.sub(r"`([^`\n]+)`", save_inline_code, text)

    text = re.sub(r"^#{1,6}\s*", "", text, flags=re.MULTILINE)
    text = re.sub(r"^-{3,}$", "", text, flags=re.MULTILINE)
    escaped = html.escape(text.strip())
    formatted = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", escaped)

    for i, block in enumerate(code_blocks):
        formatted = formatted.replace(f"@@CODEBLOCK{i}@@", block)
    for i, ic in enumerate(inline_codes):
        formatted = formatted.replace(f"@@INLINECODE{i}@@", ic)

    return formatted

def split_text_cleanly(text: str, max_len: int = 3400) -> list[str]:
    if len(text) <= max_len:
        return [text]
    chunks, current, curr_len = [], [], 0
    in_code = False
    for line in text.splitlines(keepends=True):
        if curr_len + len(line) > max_len and current:
            chunk_str = "".join(current)
            if in_code:
                chunk_str += "\n```"
            chunks.append(chunk_str)
            current = ["```\n"] if in_code else []
            curr_len = len(current[0]) if current else 0

        if line.lstrip().startswith("```"):
            in_code = not in_code

        if len(line) > max_len:
            for i in range(0, len(line), max_len):
                chunks.append(line[i:i+max_len])
        else:
            current.append(line)
            curr_len += len(line)

    if current:
        chunk_str = "".join(current)
        if in_code:
            chunk_str += "\n```"
        chunks.append(chunk_str)
    return chunks

def send_safe(chat_id: int, text: str):
    cleaned = clean_llm_output(text)
    if not cleaned:
        return
    for raw_chunk in split_text_cleanly(cleaned, max_len=3400):
        html_chunk = format_for_telegram(raw_chunk)
        try:
            bot.send_message(chat_id, html_chunk, parse_mode="HTML")
        except Exception:
            try:
                bot.send_message(chat_id, raw_chunk)
            except Exception as e:
                print(f"❌ Send error ({chat_id}): {e}")

