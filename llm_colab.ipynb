# PART 2: 5-WAY SMART ROUTER (DYNAMIC LANGUAGE LOCK)
# ==========================================
class ChatState(TypedDict):
    question: str
    chat_history: str
    chat_messages: list
    user_label: str
    target_lang: str
    img_b64: str
    route: str          # "chat", "weather", "finance", "search", "image"
    search_query: str
    tickers: list[str]
    search_results: str
    final_answer: str

def chat_router_agent(state: ChatState):
    now = datetime.now(ZoneInfo("Europe/Zurich"))
    today_str = now.strftime("%Y-%m-%d (%A)")
    next_year = now.year + 1
    has_image = bool(state.get("img_b64"))
    watchlist_str = ", ".join(get_watchlist())

    image_option = (
        "5. IMAGE -> ONLY if the user explicitly asks to inspect a NEW visual detail in the photo not yet described. "
        "Reactions, banter, or comments about your previous reply MUST be routed to CHAT, NOT IMAGE.\n"
        if has_image else ""
    )

    prompt = (
        f"Today's date: {today_str}. Default location: Basel, Switzerland. User watchlist: {watchlist_str}.\n"
        f"Recent photo available in memory: {'YES' if has_image else 'NO'}.\n"
        f"RECENT CHAT HISTORY:\n{state['chat_history']}\n\n"
        f"LATEST USER MESSAGE: {state['question']}\n\n"
        "Detect the exact language of LATEST USER MESSAGE (or the explicitly requested reply language, e.g. 'in English please') and classify intent into ONE route:\n"
        "1. CHAT -> Casual talk, banter, teasing, reactions, venting, jokes, opinions, math, translations, or pure offline coding/algorithms.\n"
        "2. WEATHER: <CityName> -> Weather, rain, temperature, or forecast.\n"
        "3. FINANCE: <TICKER1,TICKER2> | <short English news query> -> Any stock/company/ETF/crypto news, earnings, price, or follow-up about a company/stock (e.g., 'Latest News for nvidia' -> 'FINANCE: NVDA | NVIDIA NVDA stock news today'). NEVER leave tickers empty if a company/stock was mentioned in the message OR in CHAT HISTORY.\n"
        "4. SEARCH: <query1> || <query2> || <query3> -> Needs live/verifiable facts (events, concerts, sports, news, places, schedules, factual follow-ups, OR coding requiring real external APIs/docs). Use 1 query for simple facts, or 2-3 sub-queries separated by '||' for broad lists/calendars/'more' requests.\n"
        f"{image_option}\n"
        "CRITICAL RULES:\n"
        f"- UPCOMING DATE RULE: If a month already passed in {now.year}, ALWAYS use {next_year}.\n"
        "- CONTEXT CARRYOVER: If LATEST USER MESSAGE has no explicit topic (e.g., 'from today', 'in English please', 'why?', 'more'), you MUST carry over the exact subject/ticker from CHAT HISTORY. Never output a generic query without the subject.\n"
        "- 'MORE' FOLLOW-UP: Generate 2-3 DIFFERENT sub-queries targeting alternative sources/venues not yet listed.\n\n"
        "Output ONLY a single line in this EXACT format (no explanations, no steps):\n"
        "LANG: <TargetLanguageInEnglish> | <ROUTE>\n"
        "Examples:\n"
        "LANG: Turkish | CHAT\n"
        "LANG: Greek | CHAT\n"
        "LANG: German | WEATHER: Zürich\n"
        "LANG: English | FINANCE: NVDA | NVIDIA NVDA stock news today"
    )
    with llm_lock:
        raw = clean_llm_output(router_llm.invoke(prompt).content)

    lines = [ln.strip().strip('"`*') for ln in raw.splitlines() if ln.strip()]
    first_line = next(
        (ln for ln in lines if ln.upper().startswith(("LANG:", "CHAT", "WEATHER:", "FINANCE:", "SEARCH:", "IMAGE"))),
        lines[0] if lines else "LANG: English | CHAT",
    )
    target_lang = "the exact language of the user's message"

    if first_line.upper().startswith("LANG:") and "|" in first_line:
        lang_part, route_part = first_line.split("|", 1)
        target_lang = lang_part.split(":", 1)[1].strip() or target_lang
        first_line = route_part.strip()

    upper_line = first_line.upper()

    if has_image and upper_line.startswith("IMAGE"):
        print(f"   🖼️ Route: IMAGE | Lang: {target_lang}")
        return {"route": "image", "search_query": "", "tickers": [], "target_lang": target_lang}
    elif upper_line.startswith("FINANCE:"):
        payload = first_line.split(":", 1)[1].strip()
        t_part, q_part = payload.split("|", 1) if "|" in payload else (payload, f"{payload} stock news today")
        parsed_tickers = [
            t.strip().upper()
            for t in re.split(r"[,\s]+", t_part)
            if re.match(r"^[A-Z0-9\.\-\^\=]{1,12}$", t.strip().upper())
        ][:4]
        print(f"   📈 Route: FINANCE | Lang: {target_lang} | Tickers: {parsed_tickers} | Query: {q_part.strip()}")
        return {"route": "finance", "search_query": q_part.strip(), "tickers": parsed_tickers, "target_lang": target_lang}
    elif upper_line.startswith("WEATHER:"):
        city = first_line.split(":", 1)[1].strip() or "Basel"
        print(f"   🌦️ Route: WEATHER | Lang: {target_lang} | City: {city}")
        return {"route": "weather", "search_query": city, "tickers": [], "target_lang": target_lang}
    elif upper_line.startswith("SEARCH:"):
        query = first_line.split(":", 1)[1].strip() or state["question"]
        print(f"   🔍 Route: SEARCH | Lang: {target_lang} | Query: {query}")
        return {"route": "search", "search_query": query, "tickers": [], "target_lang": target_lang}
    else:
        print(f"   💬 Route: CHAT | Lang: {target_lang}")
        return {"route": "chat", "search_query": "", "tickers": [], "target_lang": target_lang}

def chat_vision_followup_agent(state: ChatState):
    ans = analyze_image_with_qwen_vl(
        state["img_b64"],
        state["question"],
        state["chat_history"],
        state.get("user_label", "User"),
        state.get("target_lang", ""),
    )
    return {"final_answer": ans}

def chat_researcher_agent(state: ChatState):
    route = state["route"]
    query = state["search_query"]
    if route == "chat":
        return {"search_results": ""}

    collected = []

    if route == "finance":
        for t in state.get("tickers", []):
            try:
                snap = get_ticker_snapshot(t)
                collected.append(f"LIVE MARKET SNAPSHOT:\n{snap['summary']}")
            except Exception as e:
                print(f"   ⚠️ Snapshot warning ({t}): {e}")
        try:
            res = tavily_fresh_news(query, max_results=4)
            if res.get("answer"):
                collected.append(f"NEWS SUMMARY (24H):\n{res['answer']}")
            for item in res.get("results", []):
                snippet = (item.get("content") or "")[:800]
                collected.append(f"[{item.get('title')}]({item.get('url')}):\n{snippet}")
        except Exception as e:
            print(f"   ⚠️ Finance news warning: {e}")

    elif route == "weather":
        city = re.sub(r"[^a-zA-ZäöüÄÖÜß\s-]", "", query).strip() or "Basel"

        def fetch_wttr():
            r = requests.get(f"https://wttr.in/{city}?format=j1", timeout=8).json()
            curr = r["current_condition"][0]
            days = r.get("weather", [])
            parts = [f"Live Weather ({city}): Now {curr['temp_C']}°C ({curr['weatherDesc'][0]['value']})."]
            if len(days) >= 1:
                hourly_str = ", ".join(
                    [f"{int(h['time'])//100:02d}:00 ({h['tempC']}°C, rain {h['chanceofrain']}%)" for h in days[0]["hourly"]]
                )
                parts.append(f"Today ({days[0]['date']}) hourly: {hourly_str}.")
            if len(days) >= 2:
                parts.append(f"Tomorrow ({days[1]['date']}): {days[1]['mintempC']}°C - {days[1]['maxtempC']}°C.")
            if len(days) >= 3:
                parts.append(f"Day after ({days[2]['date']}): {days[2]['mintempC']}°C - {days[2]['maxtempC']}°C.")
            return " ".join(parts)

        def fetch_tavily_weather():
            return tavily.search(
                query=f"weather forecast {city} 7 days hourly",
                search_depth="basic",
                max_results=2,
                include_answer=True,
            )

        with ThreadPoolExecutor(max_workers=2) as ex:
            f_wttr = ex.submit(fetch_wttr)
            f_tav = ex.submit(fetch_tavily_weather)
            try:
                collected.append(f_wttr.result())
            except Exception as e:
                print(f"   ⚠️ Weather warning: {e}")
            try:
                res = f_tav.result()
                if res.get("answer"):
                    collected.append(f"EXTENDED FORECAST SUMMARY:\n{res['answer']}")
            except Exception:
                pass

    elif route == "search":
        sub_queries = [q.strip() for q in query.split("||") if q.strip()][:3]
        if not sub_queries:
            sub_queries = [state["question"]]
        depth = "advanced" if len(sub_queries) == 1 else SEARCH_DEPTH_MULTI
        max_per_q = 6 if len(sub_queries) == 1 else 5
        snippet_limit = 1200 if len(sub_queries) == 1 else 900

        wants_today = any(k in state["question"].lower() for k in ("today", "bugün", "heute", "latest", "son dakika"))
        def run_subquery(sq: str):
            kwargs = {"query": sq, "search_depth": depth, "max_results": max_per_q, "include_answer": True}
            if wants_today:
                kwargs["time_range"] = "day"
            try:
                return sq, tavily.search(**kwargs)
            except TypeError:
                kwargs.pop("time_range", None)
                return sq, tavily.search(**kwargs)

        seen_urls = set()
        with ThreadPoolExecutor(max_workers=max(1, len(sub_queries))) as ex:
            futures = [ex.submit(run_subquery, sq) for sq in sub_queries]
            for f in futures:
                try:
                    sq, res = f.result()
                    if res.get("answer"):
                        collected.append(f"SUMMARY ({sq}):\n{res['answer']}")
                    for item in res.get("results", []):
                        url = item.get("url", "")
                        if url and url in seen_urls:
                            continue
                        if len(seen_urls) >= 12:
                            break
                        seen_urls.add(url)
                        snippet = (item.get("content") or "")[:snippet_limit]
                        collected.append(f"[{item.get('title')}]({url}):\n{snippet}")
                except Exception as e:
                    print(f"   ⚠️ Search warning: {e}")

    merged = "\n\n".join(collected)
    if len(merged) > MAX_SEARCH_CHARS:
        merged = merged[:MAX_SEARCH_CHARS] + "\n...[truncated]"

    print(f"   🌐 Sources collected: {len(collected)} ({len(merged)} chars)")
    return {"search_results": merged}

def chat_assistant_agent(state: ChatState):
    now = datetime.now(ZoneInfo("Europe/Zurich"))
    today_str = now.strftime("%d.%m.%Y (%A) %H:%M CET")
    user_label = state.get("user_label", "User")
    target_lang = state.get("target_lang") or "the exact language of the user's message"

    # 1. CASUAL CHAT MODE
    if state["route"] == "chat":
        sys_prompt = (
            f"Current time (Switzerland): {today_str}.\n"
            f"User: {user_label}.\n"
            f"Reply 100% in natural, grammatically correct {target_lang}. "
            "Be concise, grounded, and direct—not overly enthusiastic, not robotic, and avoid clichés (like always asking about coffee in the morning). "
            "If the user tells you to stop saying something, drop it immediately without arguing. "
            "Never invent live prices, dates, scores, or API URLs."
        )
        messages = (
            [SystemMessage(content=sys_prompt)]
            + state.get("chat_messages", [])
            + [HumanMessage(content=state["question"])]
        )
        with llm_lock:
            ans = clean_llm_output(chat_llm.invoke(messages).content)
        return {"final_answer": ans}

    # 2. RESEARCH / FINANCE / WEATHER MODE
    sys_prompt = (
        f"Current time (Switzerland): {today_str}.\n"
        f"User: {user_label}.\n"
        "STRICT RULES:\n"
        f"1. ABSOLUTE LANGUAGE RULE: Write 100% of your reply in {target_lang}. Completely ignore the language of earlier messages or web sources.\n"
        "2. Use ONLY facts, prices, volumes, dates, URLs, and names explicitly present in the provided sources. Never hallucinate.\n"
        "3. For stocks: prioritize live market snapshot numbers (including pre-market/after-hours and volume ratio) over older web snippets.\n"
        "4. If the sources do not contain info for the requested timeframe or topic, say so directly instead of padding with unrelated companies or dates.\n"
        "5. Keep simple answers concise (4-6 lines). For lists/calendars/events or 'more' requests, list up to 15-20 distinct matching items chronologically. For code, provide a complete working snippet inside triple backticks using ONLY verified URLs/endpoints. NO ### headers, NO --- dividers, NO internal labels.\n"
        "6. DEDUPLICATION ON FOLLOW-UPS: If the user asks for more, NEVER repeat items already mentioned in PREVIOUS CONTEXT."
    )
    user_payload = (
        f"PREVIOUS CONTEXT:\n{state['chat_history']}\n\n"
        f"SOURCES:\n{state['search_results']}\n\n"
        f"USER QUESTION [Reply strictly in {target_lang}]: {state['question']}"
    )
    with llm_lock:
        ans = clean_llm_output(
            analyst_llm.invoke([SystemMessage(content=sys_prompt), HumanMessage(content=user_payload)]).content
        )
    return {"final_answer": ans}

def route_decision(state: ChatState) -> str:
    if state["route"] == "image" and state.get("img_b64"):
        return "vision"
    return "researcher"

chat_graph = StateGraph(ChatState)
chat_graph.add_node("router", chat_router_agent)
chat_graph.add_node("vision", chat_vision_followup_agent)
chat_graph.add_node("researcher", chat_researcher_agent)
chat_graph.add_node("assistant", chat_assistant_agent)

chat_graph.set_entry_point("router")
chat_graph.add_conditional_edges("router", route_decision, {"vision": "vision", "researcher": "researcher"})
chat_graph.add_edge("vision", END)
chat_graph.add_edge("researcher", "assistant")
chat_graph.add_edge("assistant", END)
chat_app = chat_graph.compile()

