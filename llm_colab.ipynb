@bot.message_handler(commands=["add"])
def handle_add_ticker(message):
    if message.chat.id != ADMIN_CHAT_ID:
        bot.reply_to(message, "⛔ Admin only command.")
        return
    parts = (message.text or "").split()[1:]
    if not parts:
        bot.reply_to(message, "Usage: /add NVDA HUT")
        return
    added, skipped = [], []
    for p in parts:
        t = p.upper().strip()
        if re.match(r"^[A-Z0-9\.\-\^\=]{1,12}$", t) and add_watchlist_ticker(t):
            added.append(t)
        else:
            skipped.append(t)
    reply = []
    if added:
        reply.append(f"✅ Added: {', '.join(added)}")
    if skipped:
        reply.append(f"ℹ️ Already present or invalid: {', '.join(skipped)}")
    bot.reply_to(message, "\n".join(reply))

@bot.message_handler(commands=["remove"])
def handle_remove_ticker(message):
    if message.chat.id != ADMIN_CHAT_ID:
        bot.reply_to(message, "⛔ Admin only command.")
        return
    parts = (message.text or "").split()[1:]
    if not parts:
        bot.reply_to(message, "Usage: /remove NVDA")
        return
    removed, missing = [], []
    for p in parts:
        t = p.upper().strip()
        if remove_watchlist_ticker(t):
            removed.append(t)
        else:
            missing.append(t)
    reply = []
    if removed:
        reply.append(f"🗑️ Removed: {', '.join(removed)}")
    if missing:
        reply.append(f"ℹ️ Not found: {', '.join(missing)}")
    bot.reply_to(message, "\n".join(reply))

@bot.message_handler(commands=["price"])
