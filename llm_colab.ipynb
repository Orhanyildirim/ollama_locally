def init_db():
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("""CREATE TABLE IF NOT EXISTS seen_news
                     (news_hash TEXT PRIMARY KEY, ticker TEXT, title TEXT, seen_at TEXT)""")
        c.execute("""CREATE TABLE IF NOT EXISTS price_alerts
                     (alert_key TEXT PRIMARY KEY, sent_at TEXT)""")
        c.execute("""CREATE TABLE IF NOT EXISTS user_chat_history
                     (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id INTEGER, role TEXT, content TEXT, ts TEXT)""")
        c.execute("""CREATE TABLE IF NOT EXISTS watchlist
                     (ticker TEXT PRIMARY KEY, added_at TEXT)""")
        c.execute("""CREATE TABLE IF NOT EXISTS settings
                     (key TEXT PRIMARY KEY, value TEXT)""")

        c.execute("SELECT value FROM settings WHERE key = 'watchlist_seeded'")
        if c.fetchone() is None:
            now_iso = datetime.now(ZoneInfo("Europe/Zurich")).isoformat()
            for t in DEFAULT_TICKERS:
                c.execute("INSERT OR IGNORE INTO watchlist VALUES (?, ?)", (t.upper(), now_iso))
            c.execute("INSERT INTO settings VALUES ('watchlist_seeded', '1')")
        conn.commit()
        conn.close()

def get_watchlist() -> list[str]:
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT ticker FROM watchlist ORDER BY rowid ASC")
        rows = [r[0] for r in c.fetchall()]
        conn.close()
    return rows

def add_watchlist_ticker(ticker: str) -> bool:
    ticker = ticker.upper().strip()
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT 1 FROM watchlist WHERE ticker = ?", (ticker,))
        if c.fetchone():
            conn.close()
            return False
        c.execute("INSERT INTO watchlist VALUES (?, ?)", (ticker, datetime.now(ZoneInfo("Europe/Zurich")).isoformat()))
        conn.commit()
        conn.close()
    return True

def remove_watchlist_ticker(ticker: str) -> bool:
    ticker = ticker.upper().strip()
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("DELETE FROM watchlist WHERE ticker = ?", (ticker,))
        deleted = c.rowcount > 0
        conn.commit()
        conn.close()
    return deleted

def _news_hash(text: str) -> str:
    normalized = re.sub(r"[^a-z0-9]", "", text.strip().lower())
    return hashlib.sha256(normalized.encode()).hexdigest()

def is_news_seen(title: str, url: str = "") -> bool:
    keys = [_news_hash(title)]
    if url:
        keys.append(_news_hash(url))
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        for k in keys:
            c.execute("SELECT 1 FROM seen_news WHERE news_hash = ?", (k,))
            if c.fetchone() is not None:
                conn.close()
                return True
        conn.close()
    return False

def mark_news_seen(ticker: str, title: str, url: str = ""):
    ts = datetime.now(ZoneInfo("Europe/Zurich")).isoformat()
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("INSERT OR IGNORE INTO seen_news VALUES (?, ?, ?, ?)", (_news_hash(title), ticker, title, ts))
        if url:
            c.execute("INSERT OR IGNORE INTO seen_news VALUES (?, ?, ?, ?)", (_news_hash(url), ticker, title, ts))
        conn.commit()
        conn.close()

def should_send_price_alert(ticker: str, pct_move: float, trade_date: str, session: str) -> bool:
    if abs(pct_move) < ALERT_THRESHOLD_PCT:
        return False
    direction = "UP" if pct_move > 0 else "DOWN"
    bucket = int(abs(pct_move) // ALERT_THRESHOLD_PCT) * int(ALERT_THRESHOLD_PCT)
    alert_key = f"{trade_date}_{session}_{ticker}_{direction}_{bucket}"
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT 1 FROM price_alerts WHERE alert_key = ?", (alert_key,))
        if c.fetchone() is not None:
            conn.close()
            return False
        c.execute("INSERT INTO price_alerts VALUES (?, ?)", (alert_key, datetime.now(ZoneInfo("Europe/Zurich")).isoformat()))
        conn.commit()
        conn.close()
    return True

