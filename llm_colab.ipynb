def format_price(val: float, currency: str) -> str:
    symbols = {"USD": "$", "EUR": "€", "GBP": "£"}
    sym = symbols.get(currency)
    return f"{sym}{val:.2f}" if sym else f"{currency} {val:.2f}"

def tavily_fresh_news(query: str, max_results: int = 4) -> dict:
    try:
        return tavily.search(query=query, topic="news", time_range="day", max_results=max_results, include_answer=True)
    except TypeError:
        try:
            return tavily.search(query=query, topic="news", days=1, max_results=max_results, include_answer=True)
        except Exception:
            return tavily.search(query=query, topic="news", max_results=max_results)

def get_ticker_snapshot(ticker: str) -> dict:
    ticker = ticker.upper().strip()
    lines = [f"**{ticker}**"]
    max_move_pct = 0.0
    move_session = "REG"

    with yf_lock:
        stock = yf.Ticker(ticker)
        try:
            hist = stock.history(period="2mo")
        except Exception:
            hist = None
        try:
            info = stock.info or {}
        except Exception:
            info = {}
        try:
            cal = stock.calendar
        except Exception:
            cal = None

    currency = (info.get("currency") or "USD").upper()
    last_bar_date = (
        hist.index[-1].strftime("%Y-%m-%d")
        if hist is not None and len(hist) > 0
        else datetime.now(ZoneInfo("America/New_York")).strftime("%Y-%m-%d")
    )

    reg_price = info.get("regularMarketPrice")
    prev_close = info.get("regularMarketPreviousClose") or info.get("previousClose")

    if (reg_price is None or prev_close is None) and hist is not None and len(hist) >= 2:
        reg_price = float(hist["Close"].iloc[-1])
        prev_close = float(hist["Close"].iloc[-2])

    if reg_price and prev_close:
        reg_pct = ((reg_price - prev_close) / prev_close) * 100
        max_move_pct = reg_pct
        lines.append(f"• Regular: {format_price(reg_price, currency)} ({reg_pct:+.2f}%)")
    else:
        lines.append("• Price data unavailable")

    market_state = info.get("marketState", "")
    pre_price = info.get("preMarketPrice")
    post_price = info.get("postMarketPrice")

    if market_state == "PRE" and pre_price and reg_price:
        pre_pct = ((pre_price - reg_price) / reg_price) * 100
        if abs(pre_pct) > abs(max_move_pct):
            max_move_pct = pre_pct
            move_session = "PRE"
        lines.append(f"• Pre-Market: {format_price(pre_price, currency)} ({pre_pct:+.2f}%)")
    elif post_price and reg_price and market_state in ("POST", "POSTPOST", "CLOSED"):
        post_pct = ((post_price - reg_price) / reg_price) * 100
        if abs(post_pct) > abs(max_move_pct):
            max_move_pct = post_pct
            move_session = "POST"
        lines.append(f"• After-Hours: {format_price(post_price, currency)} ({post_pct:+.2f}%)")

    trade_date = (
        datetime.now(ZoneInfo("America/New_York")).strftime("%Y-%m-%d")
        if move_session == "PRE"
        else last_bar_date
    )

    if hist is not None and len(hist) >= 6:
        closes = hist["Close"]
        vols = hist["Volume"]
        last_close = float(closes.iloc[-1])

        pct_5d = ((last_close - float(closes.iloc[-6])) / float(closes.iloc[-6])) * 100
        trend_str = f"5D: {pct_5d:+.1f}%"
        if len(closes) >= 22:
            pct_1m = ((last_close - float(closes.iloc[-22])) / float(closes.iloc[-22])) * 100
            trend_str += f" | 1M: {pct_1m:+.1f}%"
        lines.append(f"• Trend: {trend_str}")

        if len(vols) >= 10:
            avg_vol = float(vols.iloc[-21:-1].mean()) if len(vols) >= 21 else float(vols.iloc[:-1].mean())
            last_vol = float(vols.iloc[-1])
            if avg_vol > 0:
                vol_ratio = last_vol / avg_vol
                vol_flag = " 🔥" if vol_ratio >= 1.8 else ""
                lines.append(f"• Volume: {last_vol/1e6:.2f}M ({vol_ratio:.2f}x 20D avg{vol_flag})")

    high_52w = info.get("fiftyTwoWeekHigh")
    ref_price = post_price or pre_price or reg_price
    if high_52w and ref_price:
        dist_high = ((ref_price - high_52w) / high_52w) * 100
        lines.append(f"• 52W High: {format_price(high_52w, currency)} ({dist_high:+.1f}% from high)")

    earnings_str = None
    try:
        ts = info.get("earningsTimestampStart") or info.get("earningsTimestamp")
        if ts:
            dt = datetime.fromtimestamp(ts, tz=ZoneInfo("Europe/Zurich"))
            if dt.date() >= datetime.now(ZoneInfo("Europe/Zurich")).date():
                earnings_str = dt.strftime("%d.%m.%Y")
        if not earnings_str and isinstance(cal, dict) and cal.get("Earnings Date"):
            ed = cal["Earnings Date"][0]
            earnings_str = ed.strftime("%d.%m.%Y") if hasattr(ed, "strftime") else str(ed)
    except Exception:
        pass
    if earnings_str:
        lines.append(f"• Next Earnings: {earnings_str}")

    return {
        "ticker": ticker,
        "summary": "\n".join(lines),
        "max_move_pct": max_move_pct,
        "trade_date": trade_date,
        "session": move_session,
    }

# ==========================================
# PART 1: PORTFOLIO RADAR AGENTS (/scan & SCHEDULER)
# ==========================================
class MarketState(TypedDict):
    tickers: list[str]
    force_report: bool
    raw_data: str
    has_new_info: bool
    has_price_shock: bool
    shock_notes: list[str]
    final_report: str

def scout_agent(state: MarketState):
    force_report = state.get("force_report", False)
    collected = []
    new_news_found = False
    shock_notes = []

    for ticker in state["tickers"]:
        snap = get_ticker_snapshot(ticker)
        move = snap["max_move_pct"]
        if abs(move) >= ALERT_THRESHOLD_PCT:
            if force_report or should_send_price_alert(ticker, move, snap["trade_date"], snap["session"]):
                shock_notes.append(f"🚨 {ticker} ({snap['session']} {move:+.2f}%)")

        new_headlines = []
        try:
            res = tavily_fresh_news(f"{ticker} stock news catalyst earnings", max_results=4)
            for r in res.get("results", []):
                title = r.get("title", "")
                url = r.get("url", "")
                if title and not is_news_seen(title, url):
                    new_news_found = True
                    mark_news_seen(ticker, title, url)
                    snippet = (r.get("content") or "")[:450]
                    new_headlines.append(f"- {title}: {snippet}")
        except Exception as e:
            new_headlines.append(f"(Search warning: {e})")

        news_block = "\n".join(new_headlines) if new_headlines else "No new news in the last 24h."
        collected.append(f"{snap['summary']}\nNews:\n{news_block}\n")
        time.sleep(0.3)

    return {
        "raw_data": "\n---\n".join(collected),
        "has_new_info": new_news_found,
        "has_price_shock": bool(shock_notes),
        "shock_notes": shock_notes,
    }

def should_run_analyst(state: MarketState) -> str:
    if state.get("force_report") or state.get("has_new_info") or state.get("has_price_shock"):
        return "analyst"
    return END

def market_analyst_agent(state: MarketState):
    prompt = (
        "You are a sharp institutional equity analyst. Review the live portfolio data below:\n"
        "1. Highlight concrete price moves (including pre-market/after-hours), volume spikes (>1.8x), upcoming earnings, and real catalysts.\n"
        "2. Ignore fluff/clickbait articles. Never invent numbers not present in the data.\n"
        "3. Write a concise, bulleted briefing for Telegram. Use **Ticker** bolding only; NO ### headers or --- dividers.\n\n"
        f"DATA:\n{state['raw_data']}"
    )
    with llm_lock:
        report = clean_llm_output(analyst_llm.invoke(prompt).content)
    return {"final_report": report}

market_graph = StateGraph(MarketState)
market_graph.add_node("scout", scout_agent)
market_graph.add_node("analyst", market_analyst_agent)
market_graph.set_entry_point("scout")
market_graph.add_conditional_edges("scout", should_run_analyst, {"analyst": "analyst", END: END})
market_graph.add_edge("analyst", END)
market_app = market_graph.compile()

