@bot.message_handler(content_types=["photo"])
def handle_user_photo(message):
    chat_id = message.chat.id
    if chat_id not in ALLOWED_CHAT_IDS:
        return

    with KeepTyping(chat_id):
        try:
            t0 = time.time()
            file_info = bot.get_file(message.photo[-1].file_id)
            downloaded_file = bot.download_file(file_info.file_path)
            img_b64 = base64.b64encode(downloaded_file).decode("utf-8")

            user_last_images[chat_id] = {"b64": img_b64, "ts": time.time()}
            user_caption = message.caption or "Describe this image."
            history = get_recent_chat(chat_id, limit=6)
            user_label = get_user_label(chat_id, message.from_user)
            answer = analyze_image_with_qwen_vl(img_b64, user_caption, history, user_label)

            save_chat(chat_id, "User", f"[Sent a photo] {user_caption}")
            save_chat(chat_id, "Assistant", answer)
            send_safe(chat_id, answer)
            print(f"🖼️ Image analyzed ({time.time() - t0:.1f}s)")
        except Exception as e:
            traceback.print_exc()
            send_safe(chat_id, f"⚠️ Image processing error: {str(e)}")

@bot.message_handler(content_types=["voice"])
def handle_user_voice(message):
    chat_id = message.chat.id
    if chat_id not in ALLOWED_CHAT_IDS:
        return

    ogg_in = tempfile.mktemp(suffix=".ogg")
    with KeepTyping(chat_id):
        try:
            t0 = time.time()
            file_info = bot.get_file(message.voice.file_id)
            downloaded = bot.download_file(file_info.file_path)
            with open(ogg_in, "wb") as f:
                f.write(downloaded)

            text, detected_lang = transcribe_voice(ogg_in)
            if not text:
                bot.reply_to(message, "⚠️ Could not understand the voice message.")
                return

            print(f"🎤 Voice ({detected_lang}) | From: {chat_id} | Text: {text}")
            history = get_recent_chat(chat_id, limit=6)
            chat_messages = get_recent_chat_messages(chat_id, limit=6)
            save_chat(chat_id, "User", f"[Voice] {text}")

            recent_img_b64 = ""
            img_entry = user_last_images.get(chat_id)
            if img_entry and (time.time() - img_entry["ts"] <= IMAGE_MEMORY_TTL):
                recent_img_b64 = img_entry["b64"]

            res = chat_app.invoke({
                "question": text,
                "chat_history": history,
                "chat_messages": chat_messages,
                "user_label": get_user_label(chat_id, message.from_user),
                "target_lang": "",
                "img_b64": recent_img_b64,
                "route": "",
                "search_query": "",
                "tickers": [],
                "search_results": "",
                "final_answer": "",
            })
            answer = res["final_answer"]
            save_chat(chat_id, "Assistant", answer)

            bot.send_chat_action(chat_id, "record_voice")
            send_voice_reply(chat_id, answer, lang=detected_lang)
            send_safe(chat_id, answer)
            print(f"✅ Voice reply sent ({time.time() - t0:.1f}s)")
        except Exception as e:
            traceback.print_exc()
            send_safe(chat_id, f"⚠️ Voice error: {str(e)}")
        finally:
            if os.path.exists(ogg_in):
                os.remove(ogg_in)

