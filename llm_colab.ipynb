}

def transcribe_voice(ogg_path: str) -> tuple[str, str]:
    segments, info = whisper_model.transcribe(ogg_path, beam_size=3)
    text = " ".join(seg.text.strip() for seg in segments).strip()
    lang = info.language if info.language in TTS_VOICES else "en"
    return text, lang

def clean_for_tts(text: str) -> str:
    text = clean_llm_output(text)
    text = re.sub(r"```.*?```", " Code block in text. ", text, flags=re.DOTALL)
    text = re.sub(r"https?://\S+", "", text)
    text = re.sub(r"[*_`#•]", "", text)
    return re.sub(r"\s+", " ", text).strip()[:1200]

def send_voice_reply(chat_id: int, text: str, lang: str = "en"):
    spoken_text = clean_for_tts(text)
    if not spoken_text:
        return
    voice = TTS_VOICES.get(lang, "en-US-AndrewNeural")
    mp3_path = tempfile.mktemp(suffix=".mp3")
    ogg_path = tempfile.mktemp(suffix=".ogg")
    try:
        async def _gen():
            await edge_tts.Communicate(spoken_text, voice).save(mp3_path)
        asyncio.run(_gen())

        subprocess.run(
            ["ffmpeg", "-y", "-i", mp3_path, "-c:a", "libopus", "-b:a", "32k", ogg_path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True,
        )
        with open(ogg_path, "rb") as audio_file:
            bot.send_voice(chat_id, audio_file)
    except Exception as e:
        print(f"⚠️ TTS error: {e}")
    finally:
        for p in (mp3_path, ogg_path):
            if os.path.exists(p):
                os.remove(p)

